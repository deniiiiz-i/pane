{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pane",
  "homepage": "https://pane.theui.company",
  "items": [
    {
      "name": "pane-style",
      "type": "registry:style",
      "dependencies": [
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "motion",
        "lucide-react"
      ],
      "devDependencies": ["tw-animate-css"],
