{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/r/**"]
    },
    "lint": {},
    "registry:build": {
      "outputs": ["public/r/**"]
    },
    "registry:validate": {},
    "test": {
      "dependsOn": ["www#registry:build"],
      "passThroughEnv": ["PANE_TEST_APP"],
      "cache": false
    }
  }
}
